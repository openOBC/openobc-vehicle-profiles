{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openobc-vehicle-catalog@1",
  "title": "OpenOBC vehicle profile catalog",
  "type": "object",
  "required": ["format", "profiles"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "openobc-vehicle-catalog@1"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "id",
        "profileId",
        "manufacturer",
        "model",
        "variant",
        "displayName",
        "description",
        "minFw",
        "supportedFeatures"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable string identifier used by the app"
        },
        "profileId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254,
          "description": "Numeric identifier understood by the firmware profile registry (0-254; 255 is reserved)"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "minFw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Minimum firmware semantic version able to activate this profile"
        },
        "supportedFeatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/feature" }
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
